# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/lgoriental?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # gere com: openssl rand -base64 32

# Login com Google (obrigatório para o provider Google — sem mock)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mercado Pago — necessário a partir da Fase 4 (checkout/pagamento)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# Melhor Envio — necessário a partir da Fase 3 (frete)
MELHOR_ENVIO_TOKEN=""

# Storage S3-compatível — necessário para upload de imagens de produto
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Senha da rota temporária POST /api/admin/seed (gere com: openssl rand -hex 24)
# Remover a rota e esta variável depois do primeiro seed em produção.
SEED_SECRET=""
